<?xml version="1.0" encoding="utf-8"?>
<!-- Menu na TV / celular deitado: logo e informações à esquerda, botões à direita -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/side_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.85"
        android:gravity="center"
        android:orientation="vertical">

        <include layout="@layout/include_info" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_art" />

        <TextView
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_notice"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:visibility="gone" />

        <include layout="@layout/include_toolbar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1.15"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_live"
                style="@style/MenuTile"
                android:contentDescription="TV ao vivo">

                <ImageView
                    style="@style/MenuTileImage"
                    android:src="@drawable/menu_live" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_movies"
                style="@style/MenuTile"
                android:contentDescription="Filmes">

                <ImageView
                    style="@style/MenuTileImage"
                    android:src="@drawable/menu_movies" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_series"
                style="@style/MenuTile"
                android:contentDescription="Séries">

                <ImageView
                    style="@style/MenuTileImage"
                    android:src="@drawable/menu_series" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_favorites"
                style="@style/MenuTile"
                android:contentDescription="Favoritos">

                <ImageView
                    style="@style/MenuTileImage"
                    android:src="@drawable/menu_favorites" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
