<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/form_side_padding"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/form_side_padding"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Reprodução -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsTitle"
                android:text="Reprodução" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Formato dos canais ao vivo"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/fmt_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/fmt_ts"
                    style="@style/SettingsOption"
                    android:text="MPEG-TS (padrão)" />

                <RadioButton
                    android:id="@+id/fmt_hls"
                    style="@style/SettingsOption"
                    android:layout_marginStart="12dp"
                    android:text="HLS" />
            </RadioGroup>

            <TextView
                style="@style/SettingsHint"
                android:text="Se algum canal não abrir ou ficar travando, experimente trocar." />

            <CheckBox
                android:id="@+id/auto_next"
                style="@style/SettingsOption"
                android:layout_marginTop="10dp"
                android:text="Tocar o próximo episódio automaticamente" />
        </LinearLayout>

        <!-- Controle dos pais -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsTitle"
                android:text="Controle dos pais" />

            <CheckBox
                android:id="@+id/parental"
                style="@style/SettingsOption"
                android:text="Pedir senha para abrir conteúdo adulto" />

            <TextView
                style="@style/SettingsHint"
                android:text="Categorias adultas ficam com cadeado e somem da busca e do &quot;Todos&quot;." />

            <Button
                android:id="@+id/change_pin"
                style="@style/SettingsButton"
                android:text="Alterar senha (PIN)" />
        </LinearLayout>

        <!-- Armazenamento -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsTitle"
                android:text="Armazenamento" />

            <TextView
                android:id="@+id/cache_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/clear_cache"
                style="@style/SettingsButton"
                android:text="Limpar cache agora" />
        </LinearLayout>

        <TextView
            android:id="@+id/about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
