<?xml version="1.0" encoding="utf-8"?>
<!-- Menu no celular em pé: logo em cima, informações, botões embaixo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/side_padding">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_art" />

    <include layout="@layout/include_info" />

    <TextView
        android:id="@+id/notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_notice"
        android:padding="12dp"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_live"
                style="@style/MenuTile"
                android:contentDescription="TV ao vivo">

                <ImageView
                    style="@style/MenuTileImage"
                    android:src="@drawable/menu_live" />

                <View
                    android:id="@+id/shade_live"
                    style="@style/MenuTileShade" />

                <TextView
                    style="@style/MenuTileLabel"
                    android:drawableTop="@drawable/ic_menu_live"
                    android:text="TV ao vivo" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_movies"
                style="@style/MenuTile"
                android:contentDescription="Filmes">

                <ImageView
                    style="@style/MenuTileImage"
                    android:src="@drawable/menu_movies" />

                <View
                    android:id="@+id/shade_movies"
                    style="@style/MenuTileShade" />

                <TextView
                    style="@style/MenuTileLabel"
                    android:drawableTop="@drawable/ic_menu_movies"
                    android:text="Filmes" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_series"
                style="@style/MenuTile"
                android:contentDescription="Séries">

                <ImageView
                    style="@style/MenuTileImage"
                    android:src="@drawable/menu_series" />

                <View
                    android:id="@+id/shade_series"
                    style="@style/MenuTileShade" />

                <TextView
                    style="@style/MenuTileLabel"
                    android:drawableTop="@drawable/ic_menu_series"
                    android:text="Séries" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_favorites"
                style="@style/MenuTile"
                android:contentDescription="Favoritos">

                <ImageView
                    style="@style/MenuTileImage"
                    android:src="@drawable/menu_favorites" />

                <View
                    android:id="@+id/shade_favorites"
                    style="@style/MenuTileShade" />

                <TextView
                    style="@style/MenuTileLabel"
                    android:drawableTop="@drawable/ic_menu_favorites"
                    android:text="Favoritos" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <include
        layout="@layout/include_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />
</LinearLayout>
