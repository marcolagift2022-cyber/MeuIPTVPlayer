<?xml version="1.0" encoding="utf-8"?>
<!-- Menu no celular em pé: logo em cima, botões embaixo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/side_padding">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_art" />

        <Button
            android:id="@+id/logout"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_focus"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Sair"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_focus"
            android:contentDescription="Atualizar lista"
            android:padding="8dp"
            android:src="@drawable/ic_refresh" />
    </FrameLayout>

    <TextView
        android:id="@+id/account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:ellipsize="end"
        android:shadowColor="#000000"
        android:shadowRadius="6"
        android:singleLine="true"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_notice"
        android:padding="12dp"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_live"
                style="@style/MenuButton"
                android:drawableTop="@drawable/ic_menu_live"
                android:text="TV ao vivo" />

            <Button
                android:id="@+id/btn_movies"
                style="@style/MenuButton"
                android:drawableTop="@drawable/ic_menu_movies"
                android:text="Filmes" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_series"
                style="@style/MenuButton"
                android:drawableTop="@drawable/ic_menu_series"
                android:text="Séries" />

            <Button
                android:id="@+id/btn_favorites"
                style="@style/MenuButton"
                android:drawableTop="@drawable/ic_menu_favorites"
                android:text="Favoritos" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
