<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/form_side_padding"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/form_side_padding"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_art" />

        <!-- Aparece enquanto o app conecta sozinho com o login salvo -->
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Conectando..."
            android:textColor="@color/text_dim"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="Digite o usuário e a senha da sua assinatura."
                android:textColor="@color/text_dim"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/username"
                style="@style/Input"
                android:layout_marginTop="20dp"
                android:hint="Usuário"
                android:inputType="text" />

            <!-- Senha com o "olhinho" para mostrar/esconder -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/password"
                    style="@style/Input"
                    android:layout_marginTop="0dp"
                    android:hint="Senha"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />

                <ImageButton
                    android:id="@+id/toggle_password"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_eye"
                    android:contentDescription="Mostrar senha"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_eye" />
            </FrameLayout>

            <Button
                android:id="@+id/enter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_focus"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:textColor="@color/error"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
