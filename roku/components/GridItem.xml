<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de canal, filme ou série na grade -->
<component name="GridItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="focusPercent" type="float" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/GridItem.brs" />
  <children>
    <Rectangle id="bg" color="0x141A17E6" />
    <Poster id="poster" loadDisplayMode="scaleToFit" failedBitmapUri="pkg:/images/placeholder.png" loadingBitmapUri="pkg:/images/placeholder.png" />
    <Label id="name" horizAlign="center" vertAlign="center" wrap="true" maxLines="2" font="font:SmallestSystemFont" color="0xF2F4F7FF" />
    <Group id="badgeGroup" visible="false" translation="[8,8]">
      <Rectangle id="badgeBg" width="90" height="36" color="0x1E7A35FF" />
      <Label id="badge" width="90" height="36" horizAlign="center" vertAlign="center" font="font:SmallestBoldSystemFont" color="0xFFFFFFFF" />
    </Group>
  </children>
</component>
