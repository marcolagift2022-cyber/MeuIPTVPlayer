<?xml version="1.0" encoding="utf-8"?>
<!-- Categorias à esquerda e grade de canais/filmes/séries à direita -->
<component name="BrowseView" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams" />
    <field id="focusMe" type="boolean" alwaysNotify="true" onChange="doFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/BrowseView.brs" />
  <children>
    <Label id="title" translation="[70,60]" font="font:LargeBoldSystemFont" color="0xF2F4F7FF" />
    <Label id="count" translation="[540,78]" width="1310" horizAlign="right" color="0xA9B5ACFF" />
    <LabelList id="cats" translation="[70,170]" itemSize="[420,62]" numRows="13" vertFocusAnimationStyle="floatingFocus"
      color="0xF2F4F7FF" focusedColor="0x0A0F0BFF" focusBitmapUri="pkg:/images/focus_fill.9.png" />
    <MarkupGrid id="grid" translation="[540,170]" itemComponentName="GridItem" drawFocusFeedbackOnTop="true"
      focusBitmapUri="pkg:/images/focus.9.png" vertFocusAnimationStyle="floatingFocus" />
    <Label id="msg" translation="[540,450]" width="1310" horizAlign="center" wrap="true" color="0xA9B5ACFF" />
    <Label id="hint" translation="[70,1020]" width="1780" color="0xA9B5ACFF" font="font:SmallestSystemFont"
      text="OK: abrir     * (asterisco): favoritar     Esquerda/Direita: categorias e lista     Voltar: menu" />
    <Timer id="catTimer" duration="0.5" repeat="false" />
  </children>
</component>
